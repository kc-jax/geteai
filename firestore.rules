rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // COMMUNITY CONTENT — Public read, authenticated write
    // These are the public-facing feeds that everyone can see.
    // =====================================================================

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // reactions, edits
      allow delete: if false;                 // no client-side deletion
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // comments
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // comments
      allow delete: if false;
    }

    match /worlds/{worldId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // =====================================================================
    // USER DATA — Only the owner can read/write their own doc
    // =====================================================================

    match /accounts/{accountId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =====================================================================
    // EVENTS — Authenticated write (for logging), public read
    // =====================================================================

    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // =====================================================================
    // AI AGENT DATA — Server-only (Cloud Functions use Admin SDK)
    // No client should ever directly read/write RIVER or ENTITY internals.
    // The entity callable functions handle all client interaction.
    // =====================================================================

    match /river/{document=**} {
      allow read: if true;   // Allow reading RIVER's public state/posts
      allow write: if false;  // Only Cloud Functions (Admin SDK) can write
    }

    match /entity/{document=**} {
      allow read: if true;   // Allow reading ENTITY's public identity
      allow write: if false;  // Only Cloud Functions (Admin SDK) can write
    }

    // =====================================================================
    // DEFAULT DENY — Everything not explicitly matched is locked
    // =====================================================================
    // (Firestore denies by default when no rule matches, so no catch-all needed)
  }
}
