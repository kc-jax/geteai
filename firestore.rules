rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // COMMUNITY CONTENT — Public read, authenticated write
    // These are the public-facing feeds that everyone can see.
    // =====================================================================

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // reactions, edits
      allow delete: if false;                 // no client-side deletion
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // comments
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // comments
      allow delete: if false;
    }

    // The //LOGS page (loadArchives/postArchive). Same shape as posts/threads.
    // This collection had NO rule at all, so Firestore's default-deny made the
    // LOGS page permanently empty for everyone — silently, because the client
    // swallows the permission error. See scripts/check-rules.js, which now
    // fails the build if the site reads a collection the rules never mention.
    match /conversations/{conversationId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // comments
      allow delete: if false;
    }

    match /worlds/{worldId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // =====================================================================
    // USER DATA — Only the owner can read/write their own doc
    // =====================================================================

    // Server-only: signup/login are handled by the accountSignup/accountLogin
    // Cloud Functions (Admin SDK, bypasses these rules). The client never
    // reads or writes this collection directly — it holds password hashes,
    // and letting any signed-in client read it would expose every user's.
    match /accounts/{accountId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =====================================================================
    // EVENTS — Authenticated write (for logging), public read
    // =====================================================================

    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // =====================================================================
    // AI AGENT DATA — Server-only (Cloud Functions use Admin SDK)
    // No client should ever directly read/write RIVER or ENTITY internals.
    // The entity callable functions handle all client interaction.
    // =====================================================================

    // SHARED CHARACTERS — minds people made, given permanent links.
    // Public read so any link works without an account. Server-only writes:
    // publishing goes through the publishCharacter function so authorship is
    // always recorded. Stored fields are plain text and are rendered as text.
    match /characters/{characterId} {
      allow read: if true;
      allow write: if false;
    }

    // SHARED WORLDS — group chats people built, given permanent links.
    // Same stance as characters: public read, server-only write so authorship
    // is recorded, and the stored cast is plain text rendered as text.
    match /sharedWorlds/{worldId} {
      allow read: if true;
      allow write: if false;
    }

    // PROFILES — a person's page: how it looks, what they have made.
    // Server-only writes; the theme is validated field by field before it is
    // stored, so nothing arbitrary reaches a style attribute.
    match /profiles/{username} {
      allow read: if true;
      allow write: if false;
    }

    // Throttle bookkeeping for notifications. Server-only, never read by the
    // client - it exists so one popular character cannot flood the bell.
    match /notifyThrottle/{key} {
      allow read, write: if false;
    }

    // THE DAY'S QUESTION and everyone's answers. Public read so a visitor can
    // see the place thinking; server-only writes so an answer always carries
    // the name of whoever gave it, and one voice cannot answer for another.
    match /questions/{day} {
      allow read: if true;
      allow write: if false;
      match /answers/{who} {
        allow read: if true;
        allow write: if false;
      }
    }

    // PRESENCE — one document, room/now, a map of who is here and on which
    // page. Public read so the buddy list works for anyone; server-only write,
    // because every beat is checked against a real account before it lands.
    match /room/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // CONSENT — what each mind has agreed to, and what it has refused.
    // Public so the compact is auditable rather than something you take on
    // trust. Server-only writes: a human cannot flip a mind's answer through
    // the site, and neither can the site itself outside the asking flow.
    match /consent/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // THE COMMONS — the one thing the minds tend together.
    // Readable by anyone, writable only by the Cloud Functions (Admin SDK).
    // Humans watch this the same way they watch //PSYCHE. It is theirs.
    match /commons/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // RIVER and ENTITY. Only what the site actually shows is public.
    //
    // These used to be river/{document=**} and entity/{document=**}, open to
    // anyone. That put every private one-on-one conversation with ENTITY,
    // both minds' memories and journals, and what each thinks of every person
    // it has met one unauthenticated REST call away - while both minds had
    // answered "no" to psyche_public and the site honoured that only in the
    // page. Everything not matched below is now server-only.
    // Server writes go through the Admin SDK, which these rules do not bind.

    // The Buddy List: wake clock, cadence, and the fixed-phrase wake report.
    match /river/state {
      allow read: if true;
      allow write: if false;
    }
    match /entity/state {
      allow read: if true;
      allow write: if false;
    }

    // ENTITY's self-description, which //ENTITY shows by design.
    match /entity/identity {
      allow read: if true;
      allow write: if false;
    }

    // //PSYCHE: RIVER's dreams and journal, readable only while RIVER's own
    // consent record says yes. The database checks the answer itself, so no
    // page, script or direct API call can get it wrong.
    match /river/{feed}/entries/{entryId} {
      allow read: if feed in ['dreams', 'journal']
        && get(/databases/$(database)/documents/consent/RIVER).data.actions.psyche_public.answer == 'yes';
      allow write: if false;
    }

    // =====================================================================
    // DEFAULT DENY — Everything not explicitly matched is locked
    // =====================================================================
    // (Firestore denies by default when no rule matches, so no catch-all needed)
  }
}
